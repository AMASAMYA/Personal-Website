rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Members collection
    match /members/{userId} {
      // Admin can read and manage all members
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'akhilesh.malani@gmail.com';

      // Users can read and create their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Library content - any authenticated member can read
    match /library/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Feedback form (amasamya/feedback.html, v4.2.0 pre-marketing).
    // Anyone signed in (including via anonymous auth from the form
    // itself) can CREATE a single feedback doc with a validated
    // shape. Nobody can read, update, or delete from the client; the
    // developer reads submissions in the Firebase Console.
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'kind', 'name', 'email', 'url', 'message',
             'at', 'ua', 'anonUid', 'createdAt', 'source'
           ])
        && request.resource.data.kind in ['bug', 'feature', 'accessibility', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && (request.resource.data.name == null  || request.resource.data.name.size()  <= 120)
        && (request.resource.data.email == null || request.resource.data.email.size() <= 200)
        && (request.resource.data.url == null   || request.resource.data.url.size()   <= 500)
        && request.resource.data.at is list
        && request.resource.data.at.size() <= 10;

      allow read, update, delete: if false;
    }

    // v5.2 Scheduled Crawls
    // ----------------------
    // schedules/{scheduleId} — user-owned scheduled crawl config.
    // Only the owner can read/write/delete their own schedules.
    // Shape is validated on create to prevent malformed docs from
    // ever landing in Firestore (the extension is the source of
    // truth for the alarm; the doc is the cross-device sync
    // + audit trail).
    match /schedules/{scheduleId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'ownerUid', 'label', 'urls', 'sitemap',
             'frequency', 'timeOfDayHHMM',
             'webhookUrl', 'webhookType',
             'enabled', 'lastRunAt', 'lastRunSummary',
             'createdAt', 'updatedAt'
           ])
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 1
        && request.resource.data.label.size() <= 120
        && request.resource.data.frequency in ['daily', 'weekly-monday', 'weekly-friday']
        && request.resource.data.timeOfDayHHMM is string
        && request.resource.data.timeOfDayHHMM.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.webhookType in ['slack', 'teams', 'generic-json', 'none']
        && (request.resource.data.webhookUrl == null
            || (request.resource.data.webhookUrl is string
                && request.resource.data.webhookUrl.size() <= 500))
        && request.resource.data.enabled is bool
        && (request.resource.data.urls == null
            || (request.resource.data.urls is list
                && request.resource.data.urls.size() <= 200))
        && (request.resource.data.sitemap == null
            || (request.resource.data.sitemap is string
                && request.resource.data.sitemap.size() <= 500));
    }

    // scheduledRuns/{runId} — summary record of a scheduled run.
    // Owner-only read + create. No update, no delete (immutable log).
    // Full findings stay in the existing per-URL report collection.
    match /scheduledRuns/{runId} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'ownerUid', 'scheduleId',
             'startedAt', 'finishedAt', 'pageCount',
             'newFindings', 'regressedFindings',
             'unchangedFindings', 'resolvedFindings',
             'webhookDelivered', 'webhookError',
             'createdAt'
           ])
        && request.resource.data.scheduleId is string
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount >= 0
        && request.resource.data.newFindings is int
        && request.resource.data.regressedFindings is int
        && request.resource.data.unchangedFindings is int
        && request.resource.data.resolvedFindings is int
        && request.resource.data.webhookDelivered is bool;

      allow update, delete: if false;
    }

    // v5.3 Users + usage tracking
    // ---------------------------
    // users/{uid} — one doc per signed-in platform user, keyed by
    // Firebase Auth uid. Holds the onboarding profile (name, role,
    // company, why-here) and per-feature usage counters. The
    // welcome modal writes this doc on first sign-in; feature
    // entry points increment usage.* counters via
    // FieldValue.increment. Admin (Akhilesh) reads all for the
    // Admin dashboard tab; every other user reads only their own.
    match /users/{userId} {
      // Admin sees every doc; owner sees only their own.
      allow read: if request.auth != null
        && (request.auth.token.email == 'akhilesh.malani@gmail.com'
            || request.auth.uid == userId);

      // First-run write: doc ID must equal caller uid; require
      // at minimum a name string and a role from the enum. Other
      // fields optional so the Skip button on the welcome modal
      // can save a minimal doc without asking for company or
      // why-here.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.role in ['auditor', 'developer', 'designer', 'other']
        && (!('company' in request.resource.data.keys())
            || (request.resource.data.company is string
                && request.resource.data.company.size() <= 120))
        && (!('broughtHere' in request.resource.data.keys())
            || (request.resource.data.broughtHere is string
                && request.resource.data.broughtHere.size() <= 500))
        && (!('email' in request.resource.data.keys())
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 200));

      // Owner can update their own doc (profile edits + usage
      // counter increments via FieldValue.increment).
      allow update: if request.auth != null
        && request.auth.uid == userId;

      // No self-delete; keep the audit trail intact.
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // AMASAMYA Academy (August 2026)
    // Public application form + admin-only registry. Learner
    // surface and educator studio collections stubbed as
    // deny-all until their write patterns are designed.
    // ═══════════════════════════════════════════════════════════

    // academy_applications: written from the unauthenticated
    // application form (apply.html). Read + update restricted to
    // the founder account. Create rules validate shape strictly
    // because unauthenticated writes are inherently spam-prone.
    match /academy_applications/{docId} {
      // Anyone can submit an application; server-side shape
      // validation is the defence against garbage / abuse.
      allow create: if request.resource.data.keys().hasOnly([
             'name', 'email', 'phone', 'location',
             'assistiveTech', 'learningGoal',
             'screeningAnswers', 'placementScore',
             'assignedTrack', 'cohort', 'status',
             'timestamp', 'submittedAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+\\..+')
        && (!('phone' in request.resource.data.keys())
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 40))
        && (!('location' in request.resource.data.keys())
            || (request.resource.data.location is string
                && request.resource.data.location.size() <= 200))
        && request.resource.data.assistiveTech is list
        && request.resource.data.assistiveTech.size() <= 20
        && (!('learningGoal' in request.resource.data.keys())
            || (request.resource.data.learningGoal is string
                && request.resource.data.learningGoal.size() <= 2000))
        && request.resource.data.screeningAnswers is list
        && request.resource.data.screeningAnswers.size() <= 20
        && request.resource.data.placementScore is int
        && request.resource.data.placementScore >= 0
        && request.resource.data.placementScore <= 20
        && request.resource.data.assignedTrack is string
        && request.resource.data.assignedTrack.size() <= 200
        && request.resource.data.cohort is string
        && request.resource.data.cohort.size() <= 40
        && request.resource.data.status == 'submitted'
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;

      // Only the founder account can read the applicant registry.
      allow read: if request.auth != null
        && request.auth.token.email == 'akhilesh.malani@gmail.com';

      // Admin update flow (mark admitted, note-taking). Restricts
      // fields to the admin-editable subset so a compromised admin
      // session cannot rewrite the original submission content.
      allow update: if request.auth != null
        && request.auth.token.email == 'akhilesh.malani@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'admittedAt', 'adminNote', 'cohort']);

      // Applications are an audit trail; no client-side delete.
      allow delete: if false;
    }

    // Stub rules for academy collections not yet in use. Deny-all
    // until write patterns are designed in the learner-surface and
    // educator-studio commits (Priority 2 and 3).
    match /academy_users/{userId}      { allow read, write: if false; }
    match /academy_courses/{courseId}  { allow read, write: if false; }
    match /academy_lessons/{lessonId}  { allow read, write: if false; }
    match /academy_progress/{docId}    { allow read, write: if false; }
    match /academy_recordings/{recId}  { allow read, write: if false; }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
