{
  "manifest_version": 3,
  "name": "AMASAMYA - Accessibility Audit Tool",
  "version": "5.3.0",
  "description": "Blind-first WCAG 2.2, GIGW 3.0 & IS 17802 audit tool. VPAT 2.4 ACR exporter, site crawler, visual diffs, and accessible sidebar results.",
  "author": "Akhilesh Malani",
  "homepage_url": "https://amasamya.com",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "Run AMASAMYA Audit (Ctrl+Shift+U)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "sidebar_action": {
    "default_title": "AMASAMYA Audit Results",
    "default_panel": "sidebar/panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "windows": "Ctrl+Shift+U",
        "linux": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Run AMASAMYA accessibility audit on the current page"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://amasamya.com/*", "https://www.amasamya.com/*", "https://amasamya.akhileshmalani.com/*"],
      "js": ["content-script-platform.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "AMASAMYA@akhileshmalani.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
